+void HwSim::fillAncestry(tEventPtr event) {
+  truthSchemaVersion = 1;
+  truthObject.assign(numparticles, -1);
+  truthPdg.clear(); truthParents.clear(); truthParentOffsets.clear();
+  truthPrevious.clear(); truthHard.clear();
+  std::vector<tcPPtr> nodes;
+  std::map<tcPPtr, int> indices;
+  const auto add = [&](tcPPtr p) -> int {
+    if(!p) return -1;
+    const auto found = indices.find(p);
+    if(found != indices.end()) return found->second;
+    int index = nodes.size();
+    indices[p] = index;
+    nodes.push_back(p);
+    return index;
+  };
+  std::map<tcPPtr, int> hard;
+  if(event->primarySubProcess()) {
+    for(const auto &p : event->primarySubProcess()->outgoing()) hard[p] = 1;
+    hard[event->primarySubProcess()->incoming().first] = 2;
+    hard[event->primarySubProcess()->incoming().second] = 2;
+  }
+  for(int i = 0; i < numparticles; ++i) {
+    const int id = std::abs(particlesToCluster_[i]->id());
+    if(id == 11 || id == 13 || id == 22) truthObject[i] = add(particlesToCluster_[i]);
+  }
+  // Iterative traversal handles shared ancestors and cycles without recursion.
+  for(size_t i = 0; i < nodes.size(); ++i) {
+    const tcPPtr p = nodes[i]; // add() can reallocate nodes
+    truthPdg.push_back(p->id());
+    truthHard.push_back(hard.count(p) ? hard[p] : 0);
+    truthPrevious.push_back(add(p->previous()));
+    truthParentOffsets.push_back(truthParents.size());
+    for(const auto &parent : p->parents()) truthParents.push_back(add(parent));
+  }
+  truthParentOffsets.push_back(truthParents.size());
 }
 
